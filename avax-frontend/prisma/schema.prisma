  @@map("defi_vaults")
}

// ═══════════════════════════════════════════════════════════════
//  OLOOLUA CFA NURSERY (Kanuvari nursery DB design, v1.0 MVP)
//  Created by prisma/sql/2026-09-30_oloolua_nursery.sql, which also holds
//  what Prisma can't express: CHECK rules, the generated survival_rate,
//  lower(email) uniqueness, GIN metadata indexes, same-CFA composite FKs,
//  updated_at + audit triggers, and the v_* dashboard views.
//
//  Every write must run inside lib/nursery/db.ts → withMember(), which sets
//  app.current_member_id for the transaction; the audit trigger refuses
//  writes with no acting member. updated_at is set by a trigger, not Prisma.
// ═══════════════════════════════════════════════════════════════

enum CfaMemberRole {
  member
  admin
  verifier
  auditor
  partner
  /// Manages inventory when the CFA turns on cfa.metadata.inventory_requires_site_manager.
  site_manager

  @@map("user_role")
}

enum CfaMemberStatus {
  active
  inactive
  suspended

  @@map("user_status")
}

enum InventoryStatus {
  in_inventory
  planted
  transferred
  dead
  sold
  distributed

  @@map("inventory_status")
}

enum NurseryWorkType {
  watering
  weeding
  mulching
  pruning
  pest_control
  transplanting
  distribution
  planting
  other

  @@map("activity_type")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE

  @@map("audit_action")
}

model Cfa {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(255)
  location    String   @db.VarChar(255)
  description String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  members             CfaMember[]
  locations           NurseryLocation[]
  inventory           SeedlingBatch[]
  activities          NurseryActivity[]
  conservationRecords ConservationRecord[]

  @@map("cfa")
}

/// A person who logs in and does the work. Linked to the Privy login by
/// authUserId (= kai_users.privyUserId). Wallet is an attribute, not an id.
model CfaMember {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId         String          @map("cfa_id") @db.Uuid
  authUserId    String?         @unique @map("auth_user_id")
  name          String          @db.VarChar(255)
  email         String          @db.VarChar(255)
  phone         String?         @db.VarChar(30)
  walletAddress String?         @map("wallet_address") @db.VarChar(42)
  role          CfaMemberRole   @default(member)
  status        CfaMemberStatus @default(active)
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  cfa Cfa @relation(fields: [cfaId], references: [id], onDelete: Restrict)

  @@unique([id, cfaId])
  @@index([cfaId], map: "members_cfa_idx")
  @@map("members")
}

/// Shared species catalogue, picked from a list rather than typed each time.
model Species {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  commonName     String   @map("common_name") @db.VarChar(255)
  scientificName String   @unique @map("scientific_name") @db.VarChar(255)
  localName      String?  @map("local_name") @db.VarChar(255)
  description    String?
  metadata       Json     @default("{}")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  batches SeedlingBatch[]

  @@map("species")
}

model NurseryLocation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId       String   @map("cfa_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String?
  latitude    Decimal? @db.Decimal(10, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  metadata    Json     @default("{}")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  cfa        Cfa               @relation(fields: [cfaId], references: [id], onDelete: Cascade)
  batches    SeedlingBatch[]
  activities NurseryActivity[]

  @@unique([cfaId, name])
  @@unique([id, cfaId])
  @@map("nursery_locations")
}

/// One batch of seedlings — the core table the dashboard counts.
model SeedlingBatch {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId        String          @map("cfa_id") @db.Uuid
  speciesId    String          @map("species_id") @db.Uuid
  locationId   String          @map("location_id") @db.Uuid
  quantity     Int
  status       InventoryStatus @default(in_inventory)
  dateReceived DateTime?       @map("date_received") @db.Date
  plantingDate DateTime?       @map("planting_date") @db.Date
  source       String?         @db.VarChar(255)
  notes        String?
  metadata     Json            @default("{}")
  createdBy    String          @map("created_by") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedBy    String          @map("updated_by") @db.Uuid
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  cfa          Cfa                   @relation(fields: [cfaId], references: [id], onDelete: Cascade)
  species      Species               @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  location     NurseryLocation       @relation(fields: [locationId], references: [id], onDelete: Restrict)
  activities   NurseryActivity[]
  observations SurvivalObservation[]

  @@unique([id, cfaId])
  @@index([cfaId, status], map: "inv_cfa_status_idx")
  @@index([speciesId], map: "inv_species_idx")
  @@index([locationId], map: "inv_location_idx")
  @@map("seedling_inventory")
}

model NurseryActivity {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId            String          @map("cfa_id") @db.Uuid
  locationId       String          @map("location_id") @db.Uuid
  inventoryId      String?         @map("inventory_id") @db.Uuid
  activityType     NurseryWorkType @map("activity_type")
  activityDate     DateTime        @default(dbgenerated("CURRENT_DATE")) @map("activity_date") @db.Date
  description      String?
  quantityAffected Int?            @map("quantity_affected")
  performedBy      String          @map("performed_by") @db.Uuid
  metadata         Json            @default("{}")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)

  cfa      Cfa             @relation(fields: [cfaId], references: [id], onDelete: Cascade)
  location NurseryLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  batch    SeedlingBatch?  @relation(fields: [inventoryId], references: [id], onDelete: SetNull)

  @@index([cfaId, activityDate(sort: Desc)], map: "act_cfa_date_idx")
  @@index([activityType], map: "act_type_idx")
  @@map("nursery_activities")
}

/// Periodic survival check on a batch. survivalRate is computed by the
/// database (GENERATED column) — never write it.
model SurvivalObservation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryId     String   @map("inventory_id") @db.Uuid
  observationDate DateTime @default(dbgenerated("CURRENT_DATE")) @map("observation_date") @db.Date
  initialQuantity Int      @map("initial_quantity")
  aliveQuantity   Int      @map("alive_quantity")
  deadQuantity    Int      @map("dead_quantity")
  survivalRate    Decimal? @map("survival_rate") @db.Decimal(5, 2)
  observedBy      String   @map("observed_by") @db.Uuid
  notes           String?
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  batch SeedlingBatch @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId, observationDate(sort: Desc)], map: "surv_inv_date_idx")
  @@map("survival_observations")
}

/// Append-only history of every change, written by the audit trigger.
model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  entityType String      @map("entity_type") @db.VarChar(100)
  entityId   String      @map("entity_id") @db.Uuid
  action     AuditAction
  oldData    Json?       @map("old_data")
  newData    Json?       @map("new_data")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_entity_idx")
  @@index([userId, createdAt(sort: Desc)], map: "audit_user_idx")
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════
//  SIHU INFORMATION HUB — CONTENT, PUBLISHING & ENGAGEMENT
//  (SIHU PRD: articles, AI pre-review, human editorial approval,
//   reader engagement, transparency, auditable revisions)
// ═══════════════════════════════════════════════════════════════

enum ContentPostStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum ContentType {
  ARTICLE
  NEWS_UPDATE
  FIELD_JOURNAL
  MARKET_NEWS
  AUDIO_PODCAST
  EDUCATIONAL_GUIDE
  VIDEO
  REPORT
  DOCUMENT
  CONSERVATION_IMPACT
}

/// A piece of content on the SIHU information hub. The canonical workflow is
/// DRAFT → SUBMITTED → (AI pre-review) → editor APPROVED/REJECTED/
/// CHANGES_REQUESTED → PUBLISHED. AI can never reach PUBLISHED on its own.
model ContentPost {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  summary         String?
  body            String
  contentType     ContentType       @default(ARTICLE)
  category        String
  language        String            @default("EN")
  status          ContentPostStatus @default(DRAFT)
  /// Transparency disclosure: HUMAN or AI_ASSISTED, set per editorial policy.
  aiDisclosure    String            @default("HUMAN")
  authorBadge     String?
  creatorName     String
  creatorUserId   String?
  creatorEmail    String?
  tags            String[]          @default([])
  mediaUrl        String?
  audioUrl        String?
  audioDurationSeconds Int?
  featured        Boolean           @default(false)
  viewsCount      Int               @default(0)
  likesCount      Int               @default(0)
  tipsEarnedKes   Float             @default(0)
  /// JSON payload from the AI pre-review engine (see sihu-ai-review.ts).
  aiReport        Json?
  editorNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  comments        PostComment[]
  likes           PostLike[]
  saves           PostSave[]
  reports         PostReport[]
  revisions       PostRevision[]

  @@index([status])
  @@index([contentType])
  @@index([category])
  @@index([publishedAt])
  @@map("content_posts")
}

/// Append-only audit trail of every workflow action on a post
/// (created / submitted / AI-reviewed / approved / published / rejected…).
model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  action    String
  actorName String
  note      String?
  snapshot  Json?
  createdAt DateTime @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_revisions")
}

/// Reader like. Deduplicated by (postId, userIdKey) so one reader = one like.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userIdKey String
  createdAt DateTime @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userIdKey])
  @@index([postId])
  @@map("post_likes")
}

/// Reader comment. Guests submit a display name; signed-in users can link their
/// KAI account. Reported comments are flagged for moderation, not deleted.
model PostComment {
  id           String    @id @default(cuid())
  postId       String
  authorName   String
  authorUserId String?
  body         String
  status       String    @default("VISIBLE") // VISIBLE | REPORTED | HIDDEN
  createdAt    DateTime  @default(now())

  post         ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
  @@map("post_comments")
}

/// Reader "save for later" bookmark. One per reader per post.
model PostSave {
  id        String   @id @default(cuid())
  postId    String
  userIdKey String
  createdAt DateTime @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userIdKey])
  @@map("post_saves")
}

/// Content moderation report from a reader (spam, misinformation, harassment…).
model PostReport {
  id        String    @id @default(cuid())
  postId    String
  userIdKey String
  reason    String
  note      String?
  // Value copied at report time so the reported text survives edits.
  snapshot  String?
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([resolved])
  @@map("post_reports")
}

// ═══════════════════════════════════════════════════════════════
//  KAI NUVARI CONSERVATION / CFA INFORMATION HUB
//  (methodologies, knowledge, resources — CFA hub PRD)
// ═══════════════════════════════════════════════════════════════

/// A standardized, modular methodology page (initially Jaza Miti &
/// GTCI). The structure stays open so new methodologies can be added
/// without rebuilding the platform.
model Methodology {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  shortDescription        String
  purpose                 String
  problemAddressed        String
  howItWorks              String[]
  activities              String[]
  requiredData            String[]
  participants            String[]
  expectedOutcomes        String[]
  conservationBenefits    String[]
  economicValue           String?
  verificationRequirements String
  relatedResources        String[]
  relatedCfas             String[]
  featured                Boolean  @default(false)
  /// KAI_CREATED | EXTERNAL | PARTNER — the hub never claims ownership of a
  /// methodology unless that relationship genuinely exists.
  ownerType               String   @default("EXTERNAL")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  resources               Resource[]

  @@index([featured])
  @@map("methodologies")
}

/// Curated conservation knowledge article (basics, tree planting, species,
/// nursery practice, restoration, biodiversity, conservation finance…).
model KnowledgeArticle {
  id                String   @id @default(cuid())
  slug              String   @unique
  category          String
  title             String
  summary           String
  body              String
  sourceAttribution String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([category])
  @@map("knowledge_articles")
}

/// A tagged external or KAI-created learning resource, with attribution.
model Resource {
  id            String       @id @default(cuid())
  title         String
  kind          String       // GUIDE | MANUAL | PAPER | TRAINING | VIDEO | DOCUMENT
  description   String?
  url           String
  sourceName    String
  sourceType    String       @default("EXTERNAL") // KAI_CREATED | EXTERNAL
  methodologyId String?
  createdAt     DateTime     @default(now())

  methodology   Methodology? @relation(fields: [methodologyId], references: [id], onDelete: SetNull)

  @@map("resources")
}

// ── 2. MSME INTELLIGENT LEDGER ───────────────────────────────────

model MsmeBusiness {
  id              String           @id @default(cuid())
  businessName    String
  ownerName       String
  phoneNumber     String           @unique
  walletAddress   String?
  category        BusinessCategory @default(RETAIL_SHOP)
  location        String
  cashFlowScore   Float            @default(50.0)
  creditLimit     Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  ledgerEntries   LedgerEntry[]
  cashFlowTokens  CashFlowToken[]

  @@map("msme_businesses")
}

enum BusinessCategory {
  AGRI_SUPPLIES
  RETAIL_SHOP
  HARDWARE
  PHARMACEUTICAL
  TEXTILE_CRAFTS
  PRODUCE_DISTRIBUTOR
}

model LedgerEntry {
  id               String      @id @default(cuid())
  businessId       String
  type             EntryType
  amountKes        Float
  counterpartyName String?
  description      String
  categoryTag      String
  paymentMethod    String      @default("CASH")
  receiptIpfsHash  String?
  aiAdvice         String?
  timestamp        DateTime    @default(now())

  business         MsmeBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
  @@map("ledger_entries")
}

enum EntryType {
  INCOME
  EXPENSE
  CREDIT_GIVEN
  DEBT_OWED
}

model CashFlowToken {
  id               String          @id @default(cuid())
  tokenRef         String          @unique
  businessId       String
  invoiceAmountKes Float
  discountPriceKes Float
  maturityDate     DateTime
  debtorName       String
  status           TokenizedStatus @default(DRAFT)
  nftTokenId       String?
  fundedByInvestor String?
  createdAt        DateTime        @default(now())

  business         MsmeBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("cash_flow_tokens")
}

enum TokenizedStatus {
  DRAFT
  LISTED_FOR_FUNDING
  FUNDED
  SETTLED_PAID
  DEFAULTED
}

// ── 3. CHAMA / SAVINGS GROUP ──────────────────────────────────────

model ChamaGroup {
  id                    String            @id @default(cuid())
  groupName             String
  registrationNumber    String?
  cyclePeriodDays       Int               @default(30)
  contributionAmount    Float
  totalPoolBalanceKes   Float             @default(0)
  yieldAllocatedKes     Float             @default(0)
  activeVaultStrategy   VaultStrategyType @default(BALANCED_YBOB_VAULT)
  groupWallet           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  members               ChamaMember[]
  contributions         ChamaContribution[]
  yieldLogs             ChamaYieldLog[]

  @@map("chama_groups")
}

enum VaultStrategyType {
  CONSERVATIVE_KES_STABLE
  BALANCED_YBOB_VAULT
  HIGH_YIELD_AVAX_POOL
}

model ChamaMember {
  id               String             @id @default(cuid())
  chamaId          String
  memberName       String
  phoneNumber      String
  role             ChamaRole          @default(MEMBER)
  totalContributed Float              @default(0)
  sharePercentage  Float              @default(0)
  joinedAt         DateTime           @default(now())

  chama            ChamaGroup         @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  contributions    ChamaContribution[]

  @@index([chamaId])
  @@map("chama_members")
}

enum ChamaRole {
  CHAIRPERSON
  TREASURER
  SECRETARY
  MEMBER
}

model ChamaContribution {
  id         String        @id @default(cuid())
  chamaId    String
  memberId   String
  amountKes  Float
  paymentRef String
  status     PaymentStatus @default(SUCCESS)
  timestamp  DateTime      @default(now())

  chama      ChamaGroup    @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  member     ChamaMember   @relation(fields: [memberId], references: [id])

  @@index([chamaId])
  @@map("chama_contributions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model ChamaYieldLog {
  id              String            @id @default(cuid())
  chamaId         String
  amountInvested  Float
  yieldEarnedKes  Float
  strategyUsed    VaultStrategyType
  txHash          String?
  generatedAt     DateTime          @default(now())

  chama           ChamaGroup        @relation(fields: [chamaId], references: [id], onDelete: Cascade)

  @@index([chamaId])
  @@map("chama_yield_logs")
}

/// KAI Playground (/nuvari) policies. Written only after the fee payment is
/// checked on Avalanche Fuji; one payment = one policy. SQL:
/// prisma/sql/2026-10-03_playground_policies.sql
model PlaygroundPolicy {
  policyId      String   @id @map("policy_id")
  serviceType   String   @map("service_type")
  /// Lowercase wallet address that paid.
  owner         String
  config        Json
  paymentAmount Decimal  @default(0) @map("payment_amount") @db.Decimal(20, 8)
  paymentTxHash String   @unique @map("payment_tx_hash")
  status        String   @default("active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([owner, createdAt(sort: Desc)], map: "playground_policies_owner")
  @@map("playground_policies")
}

/// Murals and portraits with conservation provenance. SQL:
/// prisma/sql/2026-10-05_murals.sql
model Mural {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId          String    @map("cfa_id") @db.Uuid
  slug           String    @unique
  title          String
  artist         String
  description    String?
  sizeLabel      String?   @map("size_label")
  priceKes       Int       @map("price_kes")
  /// draft | available | reserved | sold
  status         String    @default("available")
  image          Bytes?
  imageMime      String?   @map("image_mime")
  imageSha256    String?   @map("image_sha256")
  /// SHA-256 of the canonical mural + linked record fingerprints.
  provenanceHash String?   @map("provenance_hash")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  records   MuralRecord[]
  enquiries MuralEnquiry[]

  @@index([cfaId, status, createdAt(sort: Desc)], map: "murals_cfa_status")
  @@map("murals")
}

model MuralRecord {
  muralId  String @map("mural_id") @db.Uuid
  recordId String @map("record_id")
  mural    Mural  @relation(fields: [muralId], references: [id], onDelete: Cascade)

  @@id([muralId, recordId])
  @@map("mural_records")
}

model MuralEnquiry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  muralId   String   @map("mural_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  message   String?
  /// new | contacted | closed
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  mural     Mural    @relation(fields: [muralId], references: [id], onDelete: Cascade)

  @@index([muralId, createdAt(sort: Desc)], map: "mural_enquiries_mural")
  @@map("mural_enquiries")
}

/// Profile details for an email account (no wallet needed). Name and phone
/// stay on kai_users. SQL: prisma/sql/2026-10-05_member_profiles.sql
model MemberProfile {
  kaiUserId String   @id @map("kai_user_id")
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("member_profiles")
}
