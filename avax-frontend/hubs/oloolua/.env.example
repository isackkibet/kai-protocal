
# Neon Postgres connection string (never commit the real value)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Guardian AI assistant ──────────────────────────────────────────────────
# Google sign-in (OpenID Connect). Create an OAuth client and add
# {site}/api/guardian/auth/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs session cookies; must be at least 32 characters.
GUARDIAN_SESSION_SECRET=
# OpenAI-compatible chat provider used for tool calling.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional policy: admins by email, auto-approve new sign-ins as viewers,
# and a fixed public origin for the OAuth redirect.
GUARDIAN_ADMIN_EMAILS=
GUARDIAN_AUTO_VIEWER=false
GUARDIAN_SITE_URL=
