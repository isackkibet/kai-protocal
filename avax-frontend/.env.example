# ── Neon Postgres (database) ─────────────────────────────────────────────────
# Pooled connection string (Prisma Client)
DATABASE_URL=postgresql://user:pass@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct connection string (Prisma migrations / db push)
DIRECT_URL=

# ── Paystack (payments) ────────────────────────────────────────────────────────
# Server-only secret key — NEVER expose to the browser.
PAYSTACK_SECRET_KEY=replace_me_sk_live
# Public key — safe to expose; used to open the Paystack checkout popup.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=replace_me_pk_live
# Conversion rate (default 130 KES per USD). This merchant is configured for KES.
PAYSTACK_KES_PER_USD=130

# ── Privy (Google login → embedded Avalanche wallet, PRD 1) ──────────────────
# Client-safe app ID — visible in the browser (from the Privy dashboard).
NEXT_PUBLIC_PRIVY_APP_ID=clxxxxxxxxxxxxxxxxxxxx
# Server-only secret — NEVER expose to the browser. Used for server validation.
PRIVY_APP_SECRET=0x_xxxxxxxxxxxxxxxxxxx

# ── KAI Voice Agent orchestrator (single Gemini agent, PRD §3 §5) ─────────────
# Powers /api/agent (the voice/text orchestrator). Without it the agent only
# reports it's online. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ── On-chain agent rails (Avalanche Fuji) ─────────────────────────────────────
# Defaults are the deployed contract addresses (agentInfra.json). Override only
# if you redeploy and want the orchestrator to target the new ones.
# NEXT_PUBLIC_KAI_ESCROW_ADDRESS=0x04680EF6Ef98C7bD64eC280B4962875b4E14b80E
# NEXT_PUBLIC_KAI_AGENT_REGISTRY_ADDRESS=0x36C42829BF7e48cCF738f0632456ECE63ABEA2ED
# NEXT_PUBLIC_KAI_AMM_ADDRESS=0x1A201396Aa620C12bf54A394a3449d21E6837861

# SIHU editors: comma-separated emails (or Privy user ids) allowed to publish stories on /hub/review.
# With a database and no editors listed, nobody can publish.
SIHU_EDITOR_EMAILS=

# ── AI chat fallback (after Gemini and Groq) ───────────────────────────────────
# NVIDIA build.nvidia.com key. NVIDIA_MODEL is optional (default openai/gpt-oss-20b).
NVIDIA_API_KEY=
# NVIDIA_MODEL=openai/gpt-oss-20b

# ── Canuvari MRV: Hedera Guardian (verification) ───────────────────────────────
# Guardian runs in its own Docker environment (see docs/guardian-local-architecture.md).
# Locally: http://localhost:3000/api/v1 — run this app on another port (next dev -p 3001).
# Not used by any code yet: records stay SUBMITTED until the Guardian integration exists.
GUARDIAN_API_URL=
# Guardian Standard Registry login used by the backend to submit records.
GUARDIAN_USERNAME=
GUARDIAN_PASSWORD=
# Policy the records are verified against (from Guardian after publishing the policy).
GUARDIAN_POLICY_ID=

# ═══════════════════════════════════════════════════════════════════════════════
#  SECURITY  (see docs/SECURITY.md)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Canonical origin(s) ────────────────────────────────────────────────────────
# The site's own public URL. Used for the CSRF origin check and the CORS
# allow-list. Vercel's own VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL are
# trusted automatically, but set this explicitly for your production domain —
# CORS and CSRF both FAIL CLOSED, so if it is wrong your forms will not submit.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Extra origins allowed to make credentialed cross-origin API calls.
# Comma-separated. Leave empty to allow only NEXT_PUBLIC_SITE_URL + Vercel URLs.
# NEVER put "*" here: with credentials it is invalid and it is the classic CORS
# bypass. Enumerate real origins.
CSRF_ALLOWED_ORIGINS=

# ── M-Pesa callback source allow-list (defence in depth) ──────────────────────
# Safaricom's Daraja IPN is NOT signed. The callback route treats it only as a
# signal to re-confirm with Safaricom via the STK Query API, so a forged
# callback cannot credit a payment — but this list cheaply drops junk before we
# spend an API call. Comma-separated IPs or CIDR ranges, e.g.
#   196.201.214.10,196.201.214.11,196.201.213.0/24
# Leave EMPTY to skip the check (it is skipped, not defaulted to something that
# might block real Safaricom traffic). Obtain the current list from Safaricom —
# they change it.
MPESA_ALLOWED_IPS=

# ── Rate limiting ─────────────────────────────────────────────────────────────
# The in-process limiter (src/lib/security/rate-limit.ts) is a backstop, NOT
# volumetric DDoS protection: on Vercel each instance keeps its own counters and
# they reset on cold start. For real edge protection enable Vercel Firewall /
# WAF rate-limit rules — see docs/SECURITY.md → "Edge rate limiting".
#
# These optional multipliers tune the backstop. Defaults are sane.
# RATE_LIMIT_API_PER_MIN=120
# RATE_LIMIT_PAYSTACK_PER_MIN=10
# RATE_LIMIT_MPESA_PER_MIN=5
# RATE_LIMIT_AI_PER_MIN=20
# RATE_LIMIT_GLOBAL_PER_MIN=10000
# Memory ceiling for rate-limit buckets (protects against key-flood memory
# exhaustion). Each bucket is a hashed key + two numbers.
# RATE_LIMIT_MAX_KEYS=50000

