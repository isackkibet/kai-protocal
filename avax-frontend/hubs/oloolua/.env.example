# Neon Postgres connection string (never commit the real value)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Guardian AI assistant ──────────────────────────────────────────────────
# Sign-in through the KAI Nuvari Privy app, so one account works on both
# sites. Use the same values as the main KAI project, and add this site's
# domain under Allowed domains in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Signs session cookies; must be at least 32 characters.
GUARDIAN_SESSION_SECRET=
# OpenAI-compatible chat provider used for tool calling. To reuse KAI's
# Gemini key: AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# and AI_MODEL=gemini-3.6-flash.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Comma-separated emails that become Guardian Admins on sign-in.
GUARDIAN_ADMIN_EMAILS=
# true = new sign-ins become Viewers at once; false = an Admin approves them.
GUARDIAN_AUTO_VIEWER=false
# Optional prompt allowance (defaults: 3, total, admins included).
# GUARDIAN_PROMPT_LIMIT=3
# GUARDIAN_PROMPT_PERIOD=total
# GUARDIAN_PROMPT_ADMIN_EXEMPT=false

# Team inbox for the contact, commitment and pledge forms (12+ characters).
INBOX_PASSWORD=
