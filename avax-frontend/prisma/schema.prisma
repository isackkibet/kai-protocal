// ⚠️  NEVER run `prisma db push` or `prisma migrate dev` against this database.
// Parts of it live only in SQL (prisma/sql/*.sql): CHECK rules, same-CFA
// composite foreign keys, the generated survival_rate, JSON GIN indexes, the
// audit/updated_at/append-only triggers and the v_* views — plus the Oloolua
// hub's kai_activities / kai_transactions tables, which share this database.
// Prisma can't see those, so a push would silently DROP them. Schema changes
// go in a new prisma/sql/<date>_<name>.sql applied with `prisma db execute`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single source of truth for a KAI Nuvari account. Identity comes from
/// Privy (privyUserId) — there is no separate NextAuth/Auth.js user table.
model KaiUser {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  phone      String?
  // username/displayName were added here but the matching DB migration
  // (adds the columns, drops the dead NextAuth tables) is still pending —
  // see the migration SQL saved in this session. Deploying with these
  // declared while the columns don't exist yet made Prisma's default
  // select-all fetch every KaiUser query in the app: onboard, checkin,
  // tasks, referral, airdrop, ledger, CFA join/planting/survival, SDG.
  // Reverted to stop that outage; re-add once the migration has run.
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  /// Privy user ID — the sole identity link, verified server-side on every request.
  privyUserId String?    @unique
  /// How this account first signed up — EMAIL or GOOGLE. Set once at creation,
  /// never overwritten, so membership growth can be broken down by channel.
  authProvider String?
  /// Unique referral code shared with friends (PRD 2 §6), e.g. AUST92.
  referralCode String?   @unique
  /// Set to REVIEW / BLOCKED by anti-abuse tooling (PRD 2 §13).
  status     KaiUserStatus @default(NORMAL)
  /// Last successful daily-check-in claim (date-scoped, not a one-time flag —
  /// KAI Nuvari PRD §3: "a user must not claim the same daily reward twice").
  lastCheckInAt DateTime?
  activities Activity[]
  wallets    KaiWallet[]
  kaiBarLedger    KaiBarLedger[]
  taskCompletions TaskCompletion[]
  airdropEligibility AirdropEligibility?
  sentReferrals   Referral[] @relation("Referrer")
  receivedReferrals Referral[] @relation("Referred")
  forestMembership  ForestMember?
  whitelistEntry    WhitelistEntry?
  miningStat      UserMiningStat?
  miningXpEvents  MiningXpEvent[]
  dailyClaims     DailyClaim[]
  miningBalance   MiningBalance?

  @@map("kai_users")
}

/// A blockchain wallet belonging to a KAI user.
/// Supports multiple chains. Private keys are NEVER stored here.
model KaiWallet {
  id        String   @id @default(cuid())
  userId    String
  chain     Chain
  address   String
  balance   Decimal  @default(0) @db.Decimal(38, 18)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([address])
  @@map("kai_wallets")
}

/// Someone who joined by connecting a browser wallet (MetaMask/Core) rather
/// than signing in with email/Google — KaiUser requires an email, so these
/// people were never recorded anywhere. Each row is proven with a signed
/// ownership challenge (lib/wallet-signature.ts), so the count can't be
/// inflated with made-up addresses. If the same address later attaches to a
/// KaiUser (kai_wallets), the admin view counts that person once, as a member.
model WalletMember {
  id          String   @id @default(cuid())
  /// Lowercased 0x address.
  address     String   @unique
  /// Wallet app used to connect, e.g. "MetaMask", "Core".
  connector   String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Number of verified connects — a rough activity signal.
  visits      Int      @default(1)

  @@index([firstSeenAt])
  @@map("wallet_members")
}

// ═══════════════════════════════════════════════════════════════
//  KAI BAR — REWARDS & AIRDROP (PRD 2)
// ═══════════════════════════════════════════════════════════════

/// Append-only ledger of every Kai Bar point event (PRD 2 §4).
/// Balance is computed by summing these rows — never stored as a single
/// overwritable number so it stays auditable.
model KaiBarLedger {
  id          String          @id @default(cuid())
  userId      String
  type        KaiBarEntryType
  /// Signed amount, e.g. +1000 or -100 for an adjustment.
  amount      Int
  description String
  referenceId String?
  createdAt   DateTime        @default(now())

  user        KaiUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@map("kai_bar_ledger")
}

/// Configurable reward task definitions (PRD 2 §9). Frontend renders
/// whatever tasks have active === true.
model RewardTask {
  id              String         @id @default(cuid())
  name            String
  description     String?
  rewardAmount    Int
  taskType        RewardTaskType
  active          Boolean        @default(true)
  maxCompletions  Int?
  createdAt       DateTime       @default(now())

  completions     TaskCompletion[]

  @@index([active])
  @@map("reward_tasks")
}

/// Records which user completed which task (anti-repeat guard, PRD 2 §13).
model TaskCompletion {
  id        String    @id @default(cuid())
  userId    String
  taskId    String
  createdAt DateTime  @default(now())

  user      KaiUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      RewardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId])
  @@map("task_completions")
}

/// Referral tree — records the full network (PRD 2 §6, §8).
/// A referral is only rewarded after the referred user hits a milestone.
model Referral {
  id             String          @id @default(cuid())
  referrerUserId String
  referredUserId String
  referralCode   String
  status         ReferralStatus  @default(PENDING)
  createdAt      DateTime        @default(now())
  rewardedAt     DateTime?

  referrer       KaiUser         @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred       KaiUser         @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([referredUserId])
  @@index([referralCode])
  @@map("referrals")
}

/// Airdrop eligibility snapshot per user (PRD 2 §11).
model AirdropEligibility {
  id                String   @id @default(cuid())
  userId            String   @unique
  eligible          Boolean  @default(false)
  contributionScore Int      @default(0)
  referralScore     Int      @default(0)
  activityScore     Int      @default(0)
  updatedAt         DateTime @updatedAt

  user              KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("airdrop_eligibility")
}

/// A member who has a spot on the KAI waitlist whitelist — claimed by the
/// member themselves (`SELF`) or granted by ops (`ADMIN`). Presence of a row
/// means whitelisted; delete the row to revoke.
model WhitelistEntry {
  id       String         @id @default(cuid())
  userId   String         @unique
  /// Who put this member on the whitelist — used to highlight self-claims
  /// ("whitelisted himself") in the admin member list.
  joinedBy WhitelistJoin  @default(SELF)
  joinedAt DateTime       @default(now())

  user     KaiUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whitelist_entries")
}

enum WhitelistJoin {
  SELF
  ADMIN
}

// ═══════════════════════════════════════════════════════════════
//  NUVARI V4 — HASH POWER ENGINE (DAILY CLAIM × MULTIPLIER)
//  The "more active = more mining" mechanic. XP is awarded from the
//  same verified, idempotent event pipeline as Kai Bar points, and
//  drives a hypothesised Hash Power figure with decay; the daily claim
//  is a floor amount scaled by Hash Power, capped, with a treasury cut.
// ═══════════════════════════════════════════════════════════════

/// Lifetime XP (never decays) and Hash Power (decays with inactivity) per
/// user. Server-computed only — never accept a client-submitted value.
model UserMiningStat {
  id          String   @id @default(cuid())
  userId      String   @unique
  /// Never decreases — a permanent record of total earned XP.
  lifetimeXP  Decimal  @default(0) @db.Decimal(38, 18)
  /// Decays with inactivity — this is what multiplies daily claims.
  hashPower   Decimal  @default(0) @db.Decimal(38, 18)
  lastActiveAt DateTime?
  updatedAt   DateTime @updatedAt

  user        KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_mining_stats")
}

/// Append-only record of every XP award (audit + window computation).
/// XP is awarded by the same onEventVerified-style hook as Kai Bar points,
/// so it inherits the existing anti-farm idempotency rules.
model MiningXpEvent {
  id          String    @id @default(cuid())
  userId      String
  tier        MiningTier
  amount      Int
  source      String     // e.g. CHECKIN, TASK, PLANTING, SURVIVAL
  referenceId String     // the upstream event id — prevents double-award
  createdAt   DateTime  @default(now())

  user        KaiUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tier, source, referenceId])
  @@index([userId, createdAt])
  @@map("mining_xp_events")
}

/// One "Claim Drop" row per successful claim. Used for the 24h rolling
/// cooldown (not calendar-day, unlike the older checkin guard).
model DailyClaim {
  id          String   @id @default(cuid())
  userId      String
  claimAmount Decimal  @db.Decimal(38, 18)
  multiplier  Decimal  @db.Decimal(38, 18)
  hashPower   Decimal  @db.Decimal(38, 18)
  claimedAt   DateTime @default(now())

  user        KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, claimedAt])
  @@map("daily_claims")
}

/// Off-chain running balance of minted NVR credited to a user via claims.
model MiningBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  amount    Decimal  @default(0) @db.Decimal(38, 18)
  updatedAt DateTime @updatedAt

  user      KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mining_balances")
}

/// System-wide totals (spec §2): minted supply and the treasury skim.
/// Settlement to on-chain batches is out of scope for v4 (existing
/// KAIAirdropVault covers on-chain), these are the off-chain rolling totals.
model MiningSystemTotals {
  id             String   @id @default("singleton")
  mintedSupply   Decimal  @default(0) @db.Decimal(38, 18)
  treasuryReserve Decimal @default(0) @db.Decimal(38, 18)
  updatedAt      DateTime @updatedAt

  @@map("mining_system_totals")
}

enum MiningTier {
  TIER_0
  TIER_1
  TIER_2
}

/// An audit-style record of important user actions on the KAI platform.
model Activity {
  id          String         @id @default(cuid())
  userId      String
  type        ActivityType
  description String?
  amount      Decimal?       @db.Decimal(38, 18)
  status      ActivityStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  user        KaiUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("activities")
}

/// Diagnostic record of every onboarding attempt, success or failure — no
/// required KaiUser link, since the whole point is to capture the attempts
/// that never produced one. Temporary: added to find why real sign-ins
/// weren't landing in KaiUser; safe to drop once that's confirmed fixed.
model OnboardAttemptLog {
  id           String   @id @default(cuid())
  privyUserId  String?
  email        String?
  outcome      String   // OK | REJECTED
  reason       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("onboard_attempt_logs")
}

/// Temporary: raw client-side sign-in errors, captured before any request
/// even reaches /api/kai-bar/onboard (popup blocked, Privy SDK throw, etc).
/// Added alongside OnboardAttemptLog to find why real sign-ins produce zero
/// trace anywhere server-side. Safe to drop once resolved.
model ClientAuthErrorLog {
  id        String   @id @default(cuid())
  event     String   // e.g. google-signin-catch, email-signin-catch
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("client_auth_error_logs")
}

model Payment {
  id              String   @id @default(cuid())
  reference       String   @unique
  amount_subunits BigInt   @default(0)
  currency        String   @default("KES")
  status          String   @default("pending")
  email           String?
  nft_id          String?
  nft_name        String?
  wallet          String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([wallet])
  @@map("payments")
}

model CreatorPayout {
  id            String   @id @default(cuid())
  name          String   @unique
  payoutType    String   @default("mobile_money") // mobile_money | kepss
  bankCode      String?
  accountNumber String
  accountName   String?
  recipientCode String?
  currency      String   @default("KES")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("creator_payouts")
}


enum Chain {
  ARBITRUM
  AVALANCHE
}

/// Anti-abuse triage for users/rewards (PRD 2 §13).
enum KaiUserStatus {
  NORMAL
  REVIEW
  BLOCKED
}

/// Why a Kai Bar amount was credited/debited (PRD 2 §4).
enum KaiBarEntryType {
  WELCOME_BONUS
  PROFILE_COMPLETION
  EMAIL_VERIFIED
  REFERRAL
  REFERRAL_REFERRER
  REFERRAL_SECOND_LEVEL
  FIRST_TRANSACTION
  COMMUNITY_ACTIVITY
  CAMPAIGN
  TASK
  ADJUSTMENT
}

/// Which RewardTask family an entry belongs to (PRD 2 §9).
enum RewardTaskType {
  SIGNUP
  EMAIL_VERIFY
  COMPLETE_PROFILE
  INVITE_FRIEND
  FIRST_TRANSACTION
  DAILY_CHECKIN
  CAMPAIGN
  OTHER
}

enum ReferralStatus {
  PENDING
  VALID
  REWARDED
  INVALID
}

enum ActivityType {
  WALLET_CREATED
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  POLICY_CREATED
  TRANSACTION
}

enum ActivityStatus {
  PENDING
  COMPLETED
  FAILED
}

// ═══════════════════════════════════════════════════════════════
//  KAI EXTENDED SCHEMA — CFA / MSME / CHAMA
//  Added from docs/digital-mrv-db-design.md
//              docs/msme-chama-intelligent-ledger-prd.md
// ═══════════════════════════════════════════════════════════════

// ── 1. COMMUNITY FOREST ASSOCIATION (CFA) ───────────────────────

model CommunityForest {
  id             String         @id @default(cuid())
  name           String
  did            String         @unique
  locationRegion String
  boundaryGeoJson Json          @default("{}")
  establishedAt  DateTime
  treasuryWallet String?
  totalHectares  Float          @default(0)
  carbonCredits  Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members        ForestMember[]
  zones          ForestZone[]
  patrols        PatrolLog[]
  govProposals   GovProposal[]
  forestProducts ForestProduct[]
  species          TreeSpecies[]
  plantingRecords  PlantingRecord[]
  survivalRecords  SurvivalRecord[]
  nurseryEntries   NurseryInventoryEntry[]

  @@map("community_forests")
}

model ForestMember {
  id          String          @id @default(cuid())
  forestId    String
  name        String
  role        ForestMemberRole @default(GUARDIAN)
  wallet      String?
  phoneNumber String?
  joinedAt    DateTime        @default(now())
  isActive    Boolean         @default(true)
  /// Links this CFA membership to a real KAI Nuvari account so conservation
  /// activity they submit can be traced back to a Privy/points identity
  /// (KAI Nuvari PRD §7: USER → CFA Membership → Conservation Data).
  kaiUserId   String?         @unique

  forest      CommunityForest  @relation(fields: [forestId], references: [id], onDelete: Cascade)
  kaiUser     KaiUser?         @relation(fields: [kaiUserId], references: [id])
  patrols     PatrolLog[]
  plantingRecords   PlantingRecord[]
  survivalRecords   SurvivalRecord[]
  nurseryEntries    NurseryInventoryEntry[]

  @@index([forestId])
  @@map("forest_members")
}

enum ForestMemberRole {
  GUARDIAN
  AUDITOR
  ADMIN
  TREASURER
}

model ForestZone {
  id          String          @id @default(cuid())
  forestId    String
  zoneName    String
  areaHa      Float
  treeCount   Int             @default(0)
  status      ZoneStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())

  forest      CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  patrols     PatrolLog[]

  @@map("forest_zones")
}

enum ZoneStatus {
  ACTIVE
  UNDER_THREAT
  RESTORED
  PROTECTED
}

model PatrolLog {
  id           String          @id @default(cuid())
  forestId     String
  memberId     String
  zoneId       String?
  patrolDate   DateTime        @default(now())
  durationMins Int             @default(0)
  treesPlanted Int             @default(0)
  incidentType String?
  notes        String?
  gpsLat       Float?
  gpsLng       Float?
  ipfsEvidenceHash String?
  status       PatrolStatus    @default(COMPLETED)

  forest       CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  member       ForestMember    @relation(fields: [memberId], references: [id])
  zone         ForestZone?     @relation(fields: [zoneId], references: [id])

  @@index([forestId])
  @@index([patrolDate])
  @@map("patrol_logs")
}

enum PatrolStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  FLAGGED
}

model ForestProduct {
  id          String          @id @default(cuid())
  forestId    String
  name        String
  category    String
  apyPercent  Float           @default(0)
  token       String
  status      String          @default("Active")
  memberCount Int             @default(0)
  tvlKes      Float           @default(0)
  createdAt   DateTime        @default(now())

  forest      CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)

  @@map("forest_products")
}

model GovProposal {
  id          String          @id @default(cuid())
  forestId    String
  proposalRef String          @unique
  title       String
  description String?
  votesFor    Int             @default(0)
  votesAgainst Int            @default(0)
  tokenSymbol String          @default("NVR")
  status      ProposalStatus  @default(ACTIVE)
  deadline    DateTime?
  createdAt   DateTime        @default(now())

  forest      CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)

  @@map("gov_proposals")
}

enum ProposalStatus {
  ACTIVE
  PASSED
  FAILED
  EXPIRED
}

// ── 1b. TREE NURSERY / CONSERVATION DATA (KAI Nuvari PRD §5, §6) ─
// Distinct from the patrol/governance model above: this tracks the actual
// nursery operation — species stock, planting events, survival follow-ups,
// and day-to-day inventory movement — for CFAs whose first activity on the
// platform is running a tree nursery.

/// A tree species stocked by a CFA's nursery (PRD §5 "Tree species").
model TreeSpecies {
  id                String   @id @default(cuid())
  forestId          String
  name              String
  quantityAvailable Int      @default(0)
  quantityPlanted   Int      @default(0)
  quantityForSale   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  forest            CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  plantingRecords   PlantingRecord[]
  survivalRecords   SurvivalRecord[]
  nurseryEntries    NurseryInventoryEntry[]

  @@index([forestId])
  @@map("tree_species")
}

/// A planting event — species, quantity, date, CFA, and who submitted it
/// (PRD §5 "Planting").
model PlantingRecord {
  id             String   @id @default(cuid())
  forestId       String
  speciesId      String
  numberPlanted  Int
  plantedAt      DateTime @default(now())
  activity       String?
  submittedById  String?
  submittedName  String?
  /// Set once the linked submitter has been credited Kai Bar points for this
  /// record, so a record can never award points twice (PRD §7).
  pointsAwarded  Boolean  @default(false)
  createdAt      DateTime @default(now())

  forest         CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  species        TreeSpecies     @relation(fields: [speciesId], references: [id])
  submittedBy    ForestMember?   @relation(fields: [submittedById], references: [id])

  @@index([forestId])
  @@index([speciesId])
  @@map("planting_records")
}

/// A survival follow-up against an earlier planting (PRD §5 "Survival").
model SurvivalRecord {
  id               String   @id @default(cuid())
  forestId         String
  speciesId        String
  numberPlanted    Int
  numberSurviving  Int
  survivalRate     Float
  observedAt       DateTime @default(now())
  submittedById    String?
  pointsAwarded    Boolean  @default(false)
  createdAt        DateTime @default(now())

  forest           CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  species          TreeSpecies     @relation(fields: [speciesId], references: [id])
  submittedBy      ForestMember?   @relation(fields: [submittedById], references: [id])

  @@index([forestId])
  @@index([speciesId])
  @@map("survival_records")
}

/// Day-to-day nursery stock movement — ordered / planted / sold
/// (PRD §5 "Nursery inventory").
model NurseryInventoryEntry {
  id           String               @id @default(cuid())
  forestId     String
  speciesId    String?
  activityType NurseryActivityType
  quantity     Int
  note         String?
  submittedById String?
  occurredAt   DateTime             @default(now())
  createdAt    DateTime             @default(now())

  forest       CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  species      TreeSpecies?    @relation(fields: [speciesId], references: [id])
  submittedBy  ForestMember?   @relation(fields: [submittedById], references: [id])

  @@index([forestId])
  @@map("nursery_inventory_entries")
}

enum NurseryActivityType {
  ORDERED
  PLANTED
  SOLD
}

// ── MRV INTEGRITY LAYER (Canuvari MRV PRD §4–§6) ─────────────────
// One table for every kind of conservation record: the full JSON lives in
// record_versions (append-only), each version fingerprinted with SHA-256 of
// its canonical JSON and chained to the previous version's hash. Status is
// only ever written by trusted backend code (lib/mrv/records.ts) — no API
// route accepts a status from the client.

/// Verification lifecycle, driven by the Hedera Guardian result (PRD §6.1).
enum RecordVerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  /// A verifier sent it back; the submitter corrects it (new version) and it is SUBMITTED again.
  CORRECTION_REQUIRED
}

/// Proof-anchoring lifecycle, driven by the Avalanche result — independent
/// of verification: a record can be VERIFIED while its anchor failed.
enum RecordAnchorStatus {
  NOT_ANCHORED
  ANCHOR_PENDING
  ANCHORED
  ANCHOR_FAILED
}

model ConservationRecord {
  id                 String   @id @default(cuid())
  /// cfa.id (uuid) — the CFA this record belongs to.
  forestId           String   @db.Uuid
  /// What kind of record this is, e.g. "PLANTING".
  recordType         String
  /// Shape of `data` in every version, e.g. "planting/v1".
  schemaVersion      String
  /// Methodology slug the record will be verified against, e.g. "jaza-miti".
  methodology        String?
  /// Latest version number and its fingerprint (mirrors the newest row in
  /// record_versions so lists don't need a join).
  currentVersion     Int      @default(1)
  dataHash           String
  verificationStatus RecordVerificationStatus @default(SUBMITTED)
  anchorStatus       RecordAnchorStatus       @default(NOT_ANCHORED)
  /// Reference IDs Guardian returns — Guardian's own data is not copied here.
  guardianPolicyId   String?
  guardianDocumentId String?
  /// Avalanche Fuji transaction that anchored the proof.
  avalancheTxHash    String?
  anchoredAt         DateTime?
  /// Operational row this record was created from, e.g.
  /// ("planting_records", <PlantingRecord.id>), so one event is never
  /// recorded twice.
  sourceTable        String?
  sourceId           String?
  submittedByMemberId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  forest             Cfa @relation(fields: [forestId], references: [id], onDelete: Restrict)
  versions           RecordVersion[]
  reviews            VerificationReview[]
  anchorLinks        AnchorBatchRecord[]

  @@unique([sourceTable, sourceId])
  @@index([forestId])
  @@index([recordType])
  @@index([verificationStatus])
  @@map("conservation_records")
}

/// Immutable history of a conservation record. Rows are never updated or
/// deleted (a database trigger enforces this); a correction adds version
/// n+1 whose previousHash is version n's dataHash.
model RecordVersion {
  id                String   @id @default(cuid())
  recordId          String
  version           Int
  /// Full record JSON exactly as it was hashed.
  data              Json
  /// SHA-256 (hex) of the canonical JSON of `data`.
  dataHash          String
  /// dataHash of the previous version; null for version 1.
  previousHash      String?
  /// Why this version exists, e.g. "initial submission", "count corrected".
  reason            String?
  createdByMemberId String?
  createdAt         DateTime @default(now())

  record            ConservationRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@unique([recordId, version])
  @@index([dataHash])
  @@map("record_versions")
}

// ── Verification, evidence and anchoring (Kanuvari Tools & Agents PRD §4.8–§4.11)
// Created by prisma/sql/2026-10-01_verification_evidence_anchoring.sql, which
// also holds the append-only triggers, CHECK rules and the audit trigger on
// evidence. Member / CFA ids are plain columns here (no Prisma relations) so
// the existing models stay untouched.

/// One human verification decision. Append-only (DB trigger).
model VerificationReview {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordId      String   @map("record_id")
  recordVersion Int      @map("record_version")
  dataHash      String   @map("data_hash")
  /// UNDER_REVIEW | VERIFIED | REJECTED | CORRECTION_REQUIRED
  decision      String
  reason        String?
  reviewerId    String   @map("reviewer_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  record ConservationRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@index([recordId, createdAt(sort: Desc)], map: "verification_reviews_record_idx")
  @@map("verification_reviews")
}

/// A photo or document attached to a batch, activity, survival check or record.
model Evidence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId      String   @map("cfa_id") @db.Uuid
  /// seedling_inventory | nursery_activities | survival_observations | conservation_records
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(100)
  sizeBytes  Int      @map("size_bytes")
  /// SHA-256 (hex) of the file bytes.
  sha256     String   @db.Char(64)
  caption    String?
  metadata   Json     @default("{}")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  file EvidenceFile?

  @@unique([entityType, entityId, sha256], map: "evidence_unique_file")
  @@index([entityType, entityId], map: "evidence_entity_idx")
  @@map("evidence")
}

/// File bytes, kept apart from `evidence` so the audit log doesn't copy them.
model EvidenceFile {
  evidenceId String @id @map("evidence_id") @db.Uuid
  content    Bytes

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@map("evidence_files")
}

/// Verified records whose Merkle root is written to Avalanche Fuji.
model AnchorBatch {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId        String    @map("cfa_id") @db.Uuid
  /// SHA-256 Merkle root (hex, no 0x). Unique among non-cancelled batches
  /// (partial index anchor_batches_live_root, SQL only).
  merkleRoot   String    @map("merkle_root") @db.Char(64)
  recordCount  Int       @map("record_count")
  /// PENDING (waiting for the wallet transaction) | ANCHORED | CANCELLED
  status       String    @default("PENDING")
  chainId      Int       @default(43113) @map("chain_id")
  txHash       String?   @unique @map("tx_hash") @db.Char(66)
  anchoredFrom String?   @map("anchored_from") @db.VarChar(42)
  blockNumber  BigInt?   @map("block_number")
  createdBy    String    @map("created_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  anchoredAt   DateTime? @map("anchored_at") @db.Timestamptz(6)

  records AnchorBatchRecord[]

  @@map("anchor_batches")
}

model AnchorBatchRecord {
  batchId       String @map("batch_id") @db.Uuid
  recordId      String @map("record_id")
  recordVersion Int    @map("record_version")
  dataHash      String @map("data_hash") @db.Char(64)
  leafIndex     Int    @map("leaf_index")
  /// Sibling hashes from the leaf up to the root.
  proof         Json

  batch  AnchorBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  record ConservationRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)

  @@id([batchId, recordId])
  @@index([recordId], map: "anchor_batch_records_record_idx")
  @@map("anchor_batch_records")
}

// ── Phase 2 (Ecosystem PRD v1.1 §4.15, §4.17) ───────────────────
// Created by prisma/sql/2026-10-02_phase2_identity_vaults_roles.sql.

/// A stored DID document (CFA: did:web). Rebuilt when admins/verifiers change.
model DidDocument {
  did         String   @id
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  document    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([subjectType, subjectId], map: "did_documents_subject")
  @@map("did_documents")
}

/// A claim signed (EIP-712) in the issuer's own wallet. Only revocable (DB trigger).
model VerifiableCredential {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cfaId          String    @map("cfa_id") @db.Uuid
  credentialType String    @map("credential_type")
  issuerDid      String    @map("issuer_did")
  subjectDid     String    @map("subject_did")
  recordId       String?   @map("record_id")
  claim          Json
  claimHash      String    @map("claim_hash") @db.Char(66)
  signerAddress  String    @map("signer_address") @db.VarChar(42)
  signature      String
  issuedBy       String    @map("issued_by") @db.Uuid
  status         String    @default("active")
  revokedReason  String?   @map("revoked_reason")
  issuedAt       DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@index([recordId], map: "vc_record_idx")
  @@index([subjectDid], map: "vc_subject_idx")
  @@map("verifiable_credentials")
}

/// A KaiVault deployed by a DeFi admin's wallet and checked on Fuji.
model DefiVault {
  address     String   @id @db.VarChar(42)
  name        String
  shareSymbol String   @map("share_symbol")
  asset       String   @db.VarChar(42)
  assetSymbol String   @map("asset_symbol")
  strategy    String   @default("single-asset")
  feeBps      Int      @default(0) @map("fee_bps")
  owner       String   @db.VarChar(42)
  deployTx    String   @unique @map("deploy_tx") @db.Char(66)
