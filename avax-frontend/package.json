{
  "name": "avax-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:mining": "node --test src/lib/mining/engine.test.ts",
    "test:airdrop": "node --test src/lib/airdrop/engine.test.ts",
    "test:security": "node --experimental-strip-types --test src/lib/security/security.test.ts",
    "test": "npm run test:mining && npm run test:airdrop && npm run test:security && npm run test:mrv && npm run test:nursery && npm run test:ai && npm run test:defi",
    "test:mrv": "node --test src/lib/mrv/canonical.test.ts src/lib/mrv/merkle.test.ts src/lib/mrv/verification.test.ts src/lib/murals/provenance.test.ts",
    "test:nursery": "node --test src/lib/nursery/validate.test.ts src/lib/nursery/agent-logic.test.ts src/lib/nursery/evidence-rules.test.ts src/lib/nursery/quality-rules.test.ts src/lib/nursery/compliance-rules.test.ts",
    "test:ai": "node --test src/lib/ai/redact.test.ts",
    "test:defi": "node --test src/lib/defi/math.test.ts src/lib/defi/yield.test.ts src/lib/policies/payment.test.ts src/lib/sdg/tiers.test.ts",
    "test:integration": "bash scripts/integration/run.sh",
    "tokens:compile": "hardhat compile",
    "tokens:deploy:fuji": "hardhat run scripts/deploy-ecosystem-tokens.cjs --network fuji",
    "hubs:sihu": "npx --prefix hubs/sihu next dev -p 3001",
    "hubs:oloolua": "npx --prefix hubs/oloolua next dev -p 3002"
  },
  "dependencies": {
    "@avalanche-sdk/chainkit": "0.3.13",
    "@avalanche-sdk/client": "0.1.2",
    "@langchain/core": "^1.2.13",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/openai": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "@privy-io/react-auth": "^3.40.0",
    "@privy-io/server-auth": "^1.32.5",
    "@tanstack/react-query": "^5.101.4",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "html5-qrcode": "2.3.8",
    "lucide-react": "^1.33.0",
    "next": "16.3.7",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "^2.55.19",
    "wagmi": "^3.7.6",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "ws": "^8.21.0",
    "deepmerge-ts": "^8.0.2",
    "openai": {
      "undici": "^6.28.1"
    },
    "undici": "^6.28.1",
    "hardhat": {
      "undici": "^5.29.0"
    }
  }
}
