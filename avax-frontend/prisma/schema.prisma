generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The single source of truth for a KAI Nuvari account. Identity comes from
/// Privy (privyUserId) — there is no separate NextAuth/Auth.js user table.
model KaiUser {
  id         String      @id @default(cuid())
  name       String
  email      String      @unique
  phone      String?
  // username/displayName were added here but the matching DB migration
  // (adds the columns, drops the dead NextAuth tables) is still pending —
  // see the migration SQL saved in this session. Deploying with these
  // declared while the columns don't exist yet made Prisma's default
  // select-all fetch every KaiUser query in the app: onboard, checkin,
  // tasks, referral, airdrop, ledger, CFA join/planting/survival, SDG.
  // Reverted to stop that outage; re-add once the migration has run.
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  /// Privy user ID — the sole identity link, verified server-side on every request.
  privyUserId String?    @unique
  /// Unique referral code shared with friends (PRD 2 §6), e.g. AUST92.
  referralCode String?   @unique
  /// Set to REVIEW / BLOCKED by anti-abuse tooling (PRD 2 §13).
  status     KaiUserStatus @default(NORMAL)
  /// Last successful daily-check-in claim (date-scoped, not a one-time flag —
  /// KAI Nuvari PRD §3: "a user must not claim the same daily reward twice").
  lastCheckInAt DateTime?
  activities Activity[]
  wallets    KaiWallet[]
  kaiBarLedger    KaiBarLedger[]
  taskCompletions TaskCompletion[]
  airdropEligibility AirdropEligibility?
  sentReferrals   Referral[] @relation("Referrer")
  receivedReferrals Referral[] @relation("Referred")
  forestMembership  ForestMember?
  whitelistEntry    WhitelistEntry?

  @@map("kai_users")
}

/// A blockchain wallet belonging to a KAI user.
/// Supports multiple chains. Private keys are NEVER stored here.
model KaiWallet {
  id        String   @id @default(cuid())
  userId    String
  chain     Chain
  address   String
  balance   Decimal  @default(0) @db.Decimal(38, 18)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([address])
  @@map("kai_wallets")
}

// ═══════════════════════════════════════════════════════════════
//  KAI BAR — REWARDS & AIRDROP (PRD 2)
// ═══════════════════════════════════════════════════════════════

/// Append-only ledger of every Kai Bar point event (PRD 2 §4).
/// Balance is computed by summing these rows — never stored as a single
/// overwritable number so it stays auditable.
model KaiBarLedger {
  id          String          @id @default(cuid())
  userId      String
  type        KaiBarEntryType
  /// Signed amount, e.g. +1000 or -100 for an adjustment.
  amount      Int
  description String
  referenceId String?
  createdAt   DateTime        @default(now())

  user        KaiUser         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([referenceId])
  @@map("kai_bar_ledger")
}

/// Configurable reward task definitions (PRD 2 §9). Frontend renders
/// whatever tasks have active === true.
model RewardTask {
  id              String         @id @default(cuid())
  name            String
  description     String?
  rewardAmount    Int
  taskType        RewardTaskType
  active          Boolean        @default(true)
  maxCompletions  Int?
  createdAt       DateTime       @default(now())

  completions     TaskCompletion[]

  @@index([active])
  @@map("reward_tasks")
}

/// Records which user completed which task (anti-repeat guard, PRD 2 §13).
model TaskCompletion {
  id        String    @id @default(cuid())
  userId    String
  taskId    String
  createdAt DateTime  @default(now())

  user      KaiUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      RewardTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
  @@index([taskId])
  @@map("task_completions")
}

/// Referral tree — records the full network (PRD 2 §6, §8).
/// A referral is only rewarded after the referred user hits a milestone.
model Referral {
  id             String          @id @default(cuid())
  referrerUserId String
  referredUserId String
  referralCode   String
  status         ReferralStatus  @default(PENDING)
  createdAt      DateTime        @default(now())
  rewardedAt     DateTime?

  referrer       KaiUser         @relation("Referrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referred       KaiUser         @relation("Referred", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerUserId])
  @@index([referredUserId])
  @@index([referralCode])
  @@map("referrals")
}

/// Airdrop eligibility snapshot per user (PRD 2 §11).
model AirdropEligibility {
  id                String   @id @default(cuid())
  userId            String   @unique
  eligible          Boolean  @default(false)
  contributionScore Int      @default(0)
  referralScore     Int      @default(0)
  activityScore     Int      @default(0)
  updatedAt         DateTime @updatedAt

  user              KaiUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("airdrop_eligibility")
}

/// A member who has a spot on the KAI waitlist whitelist — claimed by the
/// member themselves (`SELF`) or granted by ops (`ADMIN`). Presence of a row
/// means whitelisted; delete the row to revoke.
model WhitelistEntry {
  id       String         @id @default(cuid())
  userId   String         @unique
  /// Who put this member on the whitelist — used to highlight self-claims
  /// ("whitelisted himself") in the admin member list.
  joinedBy WhitelistJoin  @default(SELF)
  joinedAt DateTime       @default(now())

  user     KaiUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whitelist_entries")
}

enum WhitelistJoin {
  SELF
  ADMIN
}

/// An audit-style record of important user actions on the KAI platform.
model Activity {
  id          String         @id @default(cuid())
  userId      String
  type        ActivityType
  description String?
  amount      Decimal?       @db.Decimal(38, 18)
  status      ActivityStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  user        KaiUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("activities")
}

model Payment {
  id              String   @id @default(cuid())
  reference       String   @unique
  amount_subunits BigInt   @default(0)
  currency        String   @default("KES")
  status          String   @default("pending")
  email           String?
  nft_id          String?
  nft_name        String?
  wallet          String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([wallet])
  @@map("payments")
}

model CreatorPayout {
  id            String   @id @default(cuid())
  name          String   @unique
  payoutType    String   @default("mobile_money") // mobile_money | kepss
  bankCode      String?
  accountNumber String
  accountName   String?
  recipientCode String?
  currency      String   @default("KES")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("creator_payouts")
}


enum Chain {
  ARBITRUM
  AVALANCHE
}

/// Anti-abuse triage for users/rewards (PRD 2 §13).
enum KaiUserStatus {
  NORMAL
  REVIEW
  BLOCKED
}

/// Why a Kai Bar amount was credited/debited (PRD 2 §4).
enum KaiBarEntryType {
  WELCOME_BONUS
  PROFILE_COMPLETION
  EMAIL_VERIFIED
  REFERRAL
  REFERRAL_REFERRER
  REFERRAL_SECOND_LEVEL
  FIRST_TRANSACTION
  COMMUNITY_ACTIVITY
  CAMPAIGN
  TASK
  ADJUSTMENT
}

/// Which RewardTask family an entry belongs to (PRD 2 §9).
enum RewardTaskType {
  SIGNUP
  EMAIL_VERIFY
  COMPLETE_PROFILE
  INVITE_FRIEND
  FIRST_TRANSACTION
  DAILY_CHECKIN
  CAMPAIGN
  OTHER
}

enum ReferralStatus {
  PENDING
  VALID
  REWARDED
  INVALID
}

enum ActivityType {
  WALLET_CREATED
  DEPOSIT
  WITHDRAWAL
  INVESTMENT
  POLICY_CREATED
  TRANSACTION
}

enum ActivityStatus {
  PENDING
  COMPLETED
  FAILED
}

// ═══════════════════════════════════════════════════════════════
//  KAI EXTENDED SCHEMA — CFA / MSME / CHAMA
//  Added from docs/digital-mrv-db-design.md
//              docs/msme-chama-intelligent-ledger-prd.md
// ═══════════════════════════════════════════════════════════════

// ── 1. COMMUNITY FOREST ASSOCIATION (CFA) ───────────────────────

model CommunityForest {
  id             String         @id @default(cuid())
  name           String
  did            String         @unique
  locationRegion String
  boundaryGeoJson Json          @default("{}")
  establishedAt  DateTime
  treasuryWallet String?
  totalHectares  Float          @default(0)
  carbonCredits  Float          @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  members        ForestMember[]
  zones          ForestZone[]
  patrols        PatrolLog[]
  govProposals   GovProposal[]
  forestProducts ForestProduct[]
  species          TreeSpecies[]
  plantingRecords  PlantingRecord[]
  survivalRecords  SurvivalRecord[]
  nurseryEntries   NurseryInventoryEntry[]

  @@map("community_forests")
}

model ForestMember {
  id          String          @id @default(cuid())
  forestId    String
  name        String
  role        ForestMemberRole @default(GUARDIAN)
  wallet      String?
  phoneNumber String?
  joinedAt    DateTime        @default(now())
  isActive    Boolean         @default(true)
  /// Links this CFA membership to a real KAI Nuvari account so conservation
  /// activity they submit can be traced back to a Privy/points identity
  /// (KAI Nuvari PRD §7: USER → CFA Membership → Conservation Data).
  kaiUserId   String?         @unique

  forest      CommunityForest  @relation(fields: [forestId], references: [id], onDelete: Cascade)
  kaiUser     KaiUser?         @relation(fields: [kaiUserId], references: [id])
  patrols     PatrolLog[]
  plantingRecords   PlantingRecord[]
  survivalRecords   SurvivalRecord[]
  nurseryEntries    NurseryInventoryEntry[]

  @@index([forestId])
  @@map("forest_members")
}

enum ForestMemberRole {
  GUARDIAN
  AUDITOR
  ADMIN
  TREASURER
}

model ForestZone {
  id          String          @id @default(cuid())
  forestId    String
  zoneName    String
  areaHa      Float
  treeCount   Int             @default(0)
  status      ZoneStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())

  forest      CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  patrols     PatrolLog[]

  @@map("forest_zones")
}

enum ZoneStatus {
  ACTIVE
  UNDER_THREAT
  RESTORED
  PROTECTED
}

model PatrolLog {
  id           String          @id @default(cuid())
  forestId     String
  memberId     String
  zoneId       String?
  patrolDate   DateTime        @default(now())
  durationMins Int             @default(0)
  treesPlanted Int             @default(0)
  incidentType String?
  notes        String?
  gpsLat       Float?
  gpsLng       Float?
  ipfsEvidenceHash String?
  status       PatrolStatus    @default(COMPLETED)

  forest       CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  member       ForestMember    @relation(fields: [memberId], references: [id])
  zone         ForestZone?     @relation(fields: [zoneId], references: [id])

  @@index([forestId])
  @@index([patrolDate])
  @@map("patrol_logs")
}

enum PatrolStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  FLAGGED
}

model ForestProduct {
  id          String          @id @default(cuid())
  forestId    String
  name        String
  category    String
  apyPercent  Float           @default(0)
  token       String
  status      String          @default("Active")
  memberCount Int             @default(0)
  tvlKes      Float           @default(0)
  createdAt   DateTime        @default(now())

  forest      CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)

  @@map("forest_products")
}

model GovProposal {
  id          String          @id @default(cuid())
  forestId    String
  proposalRef String          @unique
  title       String
  description String?
  votesFor    Int             @default(0)
  votesAgainst Int            @default(0)
  tokenSymbol String          @default("NVR")
  status      ProposalStatus  @default(ACTIVE)
  deadline    DateTime?
  createdAt   DateTime        @default(now())

  forest      CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)

  @@map("gov_proposals")
}

enum ProposalStatus {
  ACTIVE
  PASSED
  FAILED
  EXPIRED
}

// ── 1b. TREE NURSERY / CONSERVATION DATA (KAI Nuvari PRD §5, §6) ─
// Distinct from the patrol/governance model above: this tracks the actual
// nursery operation — species stock, planting events, survival follow-ups,
// and day-to-day inventory movement — for CFAs whose first activity on the
// platform is running a tree nursery.

/// A tree species stocked by a CFA's nursery (PRD §5 "Tree species").
model TreeSpecies {
  id                String   @id @default(cuid())
  forestId          String
  name              String
  quantityAvailable Int      @default(0)
  quantityPlanted   Int      @default(0)
  quantityForSale   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  forest            CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  plantingRecords   PlantingRecord[]
  survivalRecords   SurvivalRecord[]
  nurseryEntries    NurseryInventoryEntry[]

  @@index([forestId])
  @@map("tree_species")
}

/// A planting event — species, quantity, date, CFA, and who submitted it
/// (PRD §5 "Planting").
model PlantingRecord {
  id             String   @id @default(cuid())
  forestId       String
  speciesId      String
  numberPlanted  Int
  plantedAt      DateTime @default(now())
  activity       String?
  submittedById  String?
  submittedName  String?
  /// Set once the linked submitter has been credited Kai Bar points for this
  /// record, so a record can never award points twice (PRD §7).
  pointsAwarded  Boolean  @default(false)
  createdAt      DateTime @default(now())

  forest         CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  species        TreeSpecies     @relation(fields: [speciesId], references: [id])
  submittedBy    ForestMember?   @relation(fields: [submittedById], references: [id])

  @@index([forestId])
  @@index([speciesId])
  @@map("planting_records")
}

/// A survival follow-up against an earlier planting (PRD §5 "Survival").
model SurvivalRecord {
  id               String   @id @default(cuid())
  forestId         String
  speciesId        String
  numberPlanted    Int
  numberSurviving  Int
  survivalRate     Float
  observedAt       DateTime @default(now())
  submittedById    String?
  pointsAwarded    Boolean  @default(false)
  createdAt        DateTime @default(now())

  forest           CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  species          TreeSpecies     @relation(fields: [speciesId], references: [id])
  submittedBy      ForestMember?   @relation(fields: [submittedById], references: [id])

  @@index([forestId])
  @@index([speciesId])
  @@map("survival_records")
}

/// Day-to-day nursery stock movement — ordered / planted / sold
/// (PRD §5 "Nursery inventory").
model NurseryInventoryEntry {
  id           String               @id @default(cuid())
  forestId     String
  speciesId    String?
  activityType NurseryActivityType
  quantity     Int
  note         String?
  submittedById String?
  occurredAt   DateTime             @default(now())
  createdAt    DateTime             @default(now())

  forest       CommunityForest @relation(fields: [forestId], references: [id], onDelete: Cascade)
  species      TreeSpecies?    @relation(fields: [speciesId], references: [id])
  submittedBy  ForestMember?   @relation(fields: [submittedById], references: [id])

  @@index([forestId])
  @@map("nursery_inventory_entries")
}

enum NurseryActivityType {
  ORDERED
  PLANTED
  SOLD
}

// ═══════════════════════════════════════════════════════════════
//  SIHU INFORMATION HUB — CONTENT, PUBLISHING & ENGAGEMENT
//  (SIHU PRD: articles, AI pre-review, human editorial approval,
//   reader engagement, transparency, auditable revisions)
// ═══════════════════════════════════════════════════════════════

enum ContentPostStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  PUBLISHED
}

enum ContentType {
  ARTICLE
  NEWS_UPDATE
  FIELD_JOURNAL
  MARKET_NEWS
  AUDIO_PODCAST
  EDUCATIONAL_GUIDE
  VIDEO
  REPORT
  DOCUMENT
  CONSERVATION_IMPACT
}

/// A piece of content on the SIHU information hub. The canonical workflow is
/// DRAFT → SUBMITTED → (AI pre-review) → editor APPROVED/REJECTED/
/// CHANGES_REQUESTED → PUBLISHED. AI can never reach PUBLISHED on its own.
model ContentPost {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  summary         String?
  body            String
  contentType     ContentType       @default(ARTICLE)
  category        String
  language        String            @default("EN")
  status          ContentPostStatus @default(DRAFT)
  /// Transparency disclosure: HUMAN or AI_ASSISTED, set per editorial policy.
  aiDisclosure    String            @default("HUMAN")
  authorBadge     String?
  creatorName     String
  creatorUserId   String?
  creatorEmail    String?
  tags            String[]          @default([])
  mediaUrl        String?
  audioUrl        String?
  audioDurationSeconds Int?
  featured        Boolean           @default(false)
  viewsCount      Int               @default(0)
  likesCount      Int               @default(0)
  tipsEarnedKes   Float             @default(0)
  /// JSON payload from the AI pre-review engine (see sihu-ai-review.ts).
  aiReport        Json?
  editorNote      String?
  reviewedById    String?
  reviewedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  comments        PostComment[]
  likes           PostLike[]
  saves           PostSave[]
  reports         PostReport[]
  revisions       PostRevision[]

  @@index([status])
  @@index([contentType])
  @@index([category])
  @@index([publishedAt])
  @@map("content_posts")
}

/// Append-only audit trail of every workflow action on a post
/// (created / submitted / AI-reviewed / approved / published / rejected…).
model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  action    String
  actorName String
  note      String?
  snapshot  Json?
  createdAt DateTime @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("post_revisions")
}

/// Reader like. Deduplicated by (postId, userIdKey) so one reader = one like.
model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userIdKey String
  createdAt DateTime @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userIdKey])
  @@index([postId])
  @@map("post_likes")
}

/// Reader comment. Guests submit a display name; signed-in users can link their
/// KAI account. Reported comments are flagged for moderation, not deleted.
model PostComment {
  id           String    @id @default(cuid())
  postId       String
  authorName   String
  authorUserId String?
  body         String
  status       String    @default("VISIBLE") // VISIBLE | REPORTED | HIDDEN
  createdAt    DateTime  @default(now())

  post         ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([status])
  @@map("post_comments")
}

/// Reader "save for later" bookmark. One per reader per post.
model PostSave {
  id        String   @id @default(cuid())
  postId    String
  userIdKey String
  createdAt DateTime @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userIdKey])
  @@map("post_saves")
}

/// Content moderation report from a reader (spam, misinformation, harassment…).
model PostReport {
  id        String    @id @default(cuid())
  postId    String
  userIdKey String
  reason    String
  note      String?
  // Value copied at report time so the reported text survives edits.
  snapshot  String?
  resolved  Boolean   @default(false)
  createdAt DateTime  @default(now())

  post      ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([resolved])
  @@map("post_reports")
}

// ═══════════════════════════════════════════════════════════════
//  KAI NUVARI CONSERVATION / CFA INFORMATION HUB
//  (methodologies, knowledge, resources — CFA hub PRD)
// ═══════════════════════════════════════════════════════════════

/// A standardized, modular methodology page (initially Jaza Miti &
/// GTCI). The structure stays open so new methodologies can be added
/// without rebuilding the platform.
model Methodology {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  shortDescription        String
  purpose                 String
  problemAddressed        String
  howItWorks              String[]
  activities              String[]
  requiredData            String[]
  participants            String[]
  expectedOutcomes        String[]
  conservationBenefits    String[]
  economicValue           String?
  verificationRequirements String
  relatedResources        String[]
  relatedCfas             String[]
  featured                Boolean  @default(false)
  /// KAI_CREATED | EXTERNAL | PARTNER — the hub never claims ownership of a
  /// methodology unless that relationship genuinely exists.
  ownerType               String   @default("EXTERNAL")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  resources               Resource[]

  @@index([featured])
  @@map("methodologies")
}

/// Curated conservation knowledge article (basics, tree planting, species,
/// nursery practice, restoration, biodiversity, conservation finance…).
model KnowledgeArticle {
  id                String   @id @default(cuid())
  slug              String   @unique
  category          String
  title             String
  summary           String
  body              String
  sourceAttribution String?
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([category])
  @@map("knowledge_articles")
}

/// A tagged external or KAI-created learning resource, with attribution.
model Resource {
  id            String       @id @default(cuid())
  title         String
  kind          String       // GUIDE | MANUAL | PAPER | TRAINING | VIDEO | DOCUMENT
  description   String?
  url           String
  sourceName    String
  sourceType    String       @default("EXTERNAL") // KAI_CREATED | EXTERNAL
  methodologyId String?
  createdAt     DateTime     @default(now())

  methodology   Methodology? @relation(fields: [methodologyId], references: [id], onDelete: SetNull)

  @@map("resources")
}

// ── 2. MSME INTELLIGENT LEDGER ───────────────────────────────────

model MsmeBusiness {
  id              String           @id @default(cuid())
  businessName    String
  ownerName       String
  phoneNumber     String           @unique
  walletAddress   String?
  category        BusinessCategory @default(RETAIL_SHOP)
  location        String
  cashFlowScore   Float            @default(50.0)
  creditLimit     Float            @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  ledgerEntries   LedgerEntry[]
  cashFlowTokens  CashFlowToken[]

  @@map("msme_businesses")
}

enum BusinessCategory {
  AGRI_SUPPLIES
  RETAIL_SHOP
  HARDWARE
  PHARMACEUTICAL
  TEXTILE_CRAFTS
  PRODUCE_DISTRIBUTOR
}

model LedgerEntry {
  id               String      @id @default(cuid())
  businessId       String
  type             EntryType
  amountKes        Float
  counterpartyName String?
  description      String
  categoryTag      String
  paymentMethod    String      @default("CASH")
  receiptIpfsHash  String?
  aiAdvice         String?
  timestamp        DateTime    @default(now())

  business         MsmeBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([type])
  @@map("ledger_entries")
}

enum EntryType {
  INCOME
  EXPENSE
  CREDIT_GIVEN
  DEBT_OWED
}

model CashFlowToken {
  id               String          @id @default(cuid())
  tokenRef         String          @unique
  businessId       String
  invoiceAmountKes Float
  discountPriceKes Float
  maturityDate     DateTime
  debtorName       String
  status           TokenizedStatus @default(DRAFT)
  nftTokenId       String?
  fundedByInvestor String?
  createdAt        DateTime        @default(now())

  business         MsmeBusiness    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("cash_flow_tokens")
}

enum TokenizedStatus {
  DRAFT
  LISTED_FOR_FUNDING
  FUNDED
  SETTLED_PAID
  DEFAULTED
}

// ── 3. CHAMA / SAVINGS GROUP ──────────────────────────────────────

model ChamaGroup {
  id                    String            @id @default(cuid())
  groupName             String
  registrationNumber    String?
  cyclePeriodDays       Int               @default(30)
  contributionAmount    Float
  totalPoolBalanceKes   Float             @default(0)
  yieldAllocatedKes     Float             @default(0)
  activeVaultStrategy   VaultStrategyType @default(BALANCED_YBOB_VAULT)
  groupWallet           String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  members               ChamaMember[]
  contributions         ChamaContribution[]
  yieldLogs             ChamaYieldLog[]

  @@map("chama_groups")
}

enum VaultStrategyType {
  CONSERVATIVE_KES_STABLE
  BALANCED_YBOB_VAULT
  HIGH_YIELD_AVAX_POOL
}

model ChamaMember {
  id               String             @id @default(cuid())
  chamaId          String
  memberName       String
  phoneNumber      String
  role             ChamaRole          @default(MEMBER)
  totalContributed Float              @default(0)
  sharePercentage  Float              @default(0)
  joinedAt         DateTime           @default(now())

  chama            ChamaGroup         @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  contributions    ChamaContribution[]

  @@index([chamaId])
  @@map("chama_members")
}

enum ChamaRole {
  CHAIRPERSON
  TREASURER
  SECRETARY
  MEMBER
}

model ChamaContribution {
  id         String        @id @default(cuid())
  chamaId    String
  memberId   String
  amountKes  Float
  paymentRef String
  status     PaymentStatus @default(SUCCESS)
  timestamp  DateTime      @default(now())

  chama      ChamaGroup    @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  member     ChamaMember   @relation(fields: [memberId], references: [id])

  @@index([chamaId])
  @@map("chama_contributions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model ChamaYieldLog {
  id              String            @id @default(cuid())
  chamaId         String
  amountInvested  Float
  yieldEarnedKes  Float
  strategyUsed    VaultStrategyType
  txHash          String?
  generatedAt     DateTime          @default(now())

  chama           ChamaGroup        @relation(fields: [chamaId], references: [id], onDelete: Cascade)

  @@index([chamaId])
  @@map("chama_yield_logs")
}
